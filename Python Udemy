if balance > 0:
    print("Puedes pagar, prueba")
if balance > 501:
    print("Puedes pagar") #Esto no se mostraria porq no se cumple la condicion


"""
if... else...
Si una condicion es evaluada como verdadera se ejecutara un codigo.
Pero algunas veces deseas tener otra accion que se realice en caso
de que la condicion evaluada no se cumpla.
"""


#Ejemplo completo
balances = 0 
if balances > 0:
    print("Puedes pagar")
else:
    print("No tienes saldo")


#Likes, para valores iguales
likes = 200
if likes == 200:
    print("\nExcelente, 200 likes")
#Para mayor 
likes = 200
if likes > 200:
    print("Excelente, 200 likes")
else:
    print("Casi llegas a los 200") #se mostraria el else aunque ya tengamos 200
#Para poder mostrarlo
if likes >= 200:
    print("Excelente, 200 likes")
else:
    print("Casi llegas a los 200") 


