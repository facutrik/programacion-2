"""
if... elif... else...
Algunas ocasiones deseas evaluar una condicion u otra y realizar
diferentes acciones segun sea el caso.
En python es ELIF, en otro es else if.

La sintaxis es:
ocupacion = ""
if ocupacion == "":
    print("")
elif ocupacion == ""
    print("")
else:
    print("")
"""

#Ejemplo con elif
ocupacion = "Estudiante"
if ocupacion == "Estudiante":
    print("\nTienes 50% de desc")
elif ocupacion == "Jubilado":
    print("Tienes 75% de desc")
else:
    print("Debes pagar el 100%")
#Otro ejemplo agregado otro ELIF
ocupacion = "Desempleado"
if ocupacion == "Estudiante":
    print("\nTienes 50% de desc")
elif ocupacion == "Jubilado":
    print("Tienes 75% de desc")
elif ocupacion == "Desempleado":
    print("Tienes un 10% de descuento") #Va a ejecutar el codigo que SI se cumpla
else:
    print("Debes pagar el 100%")


"""
Revisando 2 o mas condiciones:
if y elif revisaran que se cumpla una condicion.
Algunas veces requieres codigo que se revise que se cumplan 2 o mas condiciones,
o que se cumpla al menos 1. 
"""
#Operadores AND y OR
#OPERADORES AND
usuario_logueado = True
usuario_adm = False
if usuario_logueado and usuario_adm: #Pedimos que se cumpla UNA condicion Y la OTRA
    print("Administrador")
elif usuario_logueado:
    print("Acceso al sistema") #Nos mostraria este elif, ya que se cumple solo 1
else:
    print("Debes iniciar sesion")
#OPERADORES OR
if usuario_logueado or usuario_adm: #Pedimos que se cumpla UNA condicion O la OTRA
    print("Administrador") #Mostraria esta porq se cumple al menos UNA condicion
elif usuario_logueado:
    print("Acceso al sistema")
else:
    print("Debes iniciar sesion")



